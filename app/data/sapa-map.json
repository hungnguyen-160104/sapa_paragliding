{"points":[{"id":"sun-plaza","cat":"town","lat":22.33456,"lon":103.84048,"vi":"Sun Plaza – Quảng trường Sa Pa (sân quần)","en":"Sun Plaza – Sapa Square","dvi":"Trung tâm thị trấn. Ga tàu leo núi Mường Hoa xuất phát từ trong toà Sun Plaza; đây cũng là điểm hẹn đón khách đi bay dù lượn.","den":"The heart of town. The Muong Hoa funicular leaves from inside Sun Plaza; it is also the meeting point for paragliding pick-ups.","n":1},{"id":"stone-church","cat":"town","lat":22.3352,"lon":103.84225,"vi":"Nhà thờ đá Sa Pa","en":"Sapa Stone Church","dvi":"Nhà thờ đá cổ ngay cạnh quảng trường, điểm chụp ảnh quen thuộc nhất thị trấn.","den":"The old stone church beside the square, the most photographed spot in town.","n":2},{"id":"ham-rong","cat":"town","lat":22.33363,"lon":103.8468,"vi":"Núi Hàm Rồng","en":"Ham Rong Mountain","dvi":"Khu vườn đá và vườn hoa trên núi sau nhà thờ đá, có sân mây nhìn xuống toàn cảnh thị trấn.","den":"Rock gardens and flower gardens on the hill behind the church, with a viewing deck over the whole town.","n":3},{"id":"sapa-lake","cat":"town","lat":22.33811,"lon":103.84626,"vi":"Hồ Sa Pa","en":"Sapa Lake","dvi":"Hồ nước giữa thị trấn, đi bộ một vòng mất khoảng 20 phút.","den":"The lake in the middle of town; a walk around it takes about 20 minutes.","n":4},{"id":"sapa-market","cat":"town","lat":22.33829,"lon":103.85198,"vi":"Chợ Sa Pa","en":"Sapa Market","dvi":"Chợ trung tâm: thổ cẩm, đặc sản và đồ ăn địa phương.","den":"The central market: brocade, local specialities and food.","n":5},{"id":"moana","cat":"town","lat":22.32736,"lon":103.84628,"approx":true,"vi":"Moana Sapa","en":"Moana Sapa","dvi":"Khu check-in nhìn xuống thung lũng Mường Hoa với các tiểu cảnh chụp ảnh.","den":"A photo park overlooking Muong Hoa Valley with staged viewpoints.","n":6},{"id":"fansipan-station","cat":"fansipan","lat":22.33708,"lon":103.82432,"vi":"Ga cáp treo Fansipan (ga Mường Hoa)","en":"Fansipan cable car station (Muong Hoa)","dvi":"Tàu leo núi từ Sun Plaza dừng ở ga Mường Hoa; từ đây lên cáp treo đi đỉnh Fansipan.","den":"The funicular from Sun Plaza ends at Muong Hoa station; the cable car to Fansipan starts here.","n":7},{"id":"fansipan","cat":"fansipan","lat":22.30308,"lon":103.77544,"vi":"Đỉnh Fansipan (3.143 m)","en":"Fansipan summit (3,143 m)","dvi":"\"Nóc nhà Đông Dương\". Lên bằng cáp treo trong buổi sáng, hoặc leo bộ 1–2 ngày từ Trạm Tôn.","den":"\"The Roof of Indochina\". Reach it by cable car in a morning, or trek 1–2 days from Tram Ton.","n":8},{"id":"tram-ton","cat":"fansipan","lat":22.35275,"lon":103.76552,"vi":"Trạm Tôn – cửa rừng leo Fansipan","en":"Tram Ton – Fansipan trailhead","dvi":"Điểm xuất phát cung leo bộ Fansipan phổ biến nhất, nằm trên đèo Ô Quy Hồ.","den":"Start of the most popular Fansipan trekking route, on O Quy Ho Pass.","n":9},{"id":"takeoff","cat":"fly","lat":22.3219262,"lon":103.8766636,"vi":"Điểm cất cánh dù lượn – bản Hang Đá (1.500 m)","en":"Paragliding take-off – Hang Da village (1,500 m)","dvi":"Bãi cất cánh và văn phòng Sapa Paragliding, nhìn thẳng xuống thung lũng Mường Hoa.","den":"Sapa Paragliding take-off and office, facing straight down Muong Hoa Valley.","n":10},{"id":"landing","cat":"fly","lat":22.3097778,"lon":103.8757778,"vi":"Lao Chải – điểm hạ cánh dù lượn","en":"Lao Chai – paragliding landing","dvi":"Bãi hạ cánh cạnh cầu Lao Chải, giữa ruộng bậc thang. Từ đây đi bộ tiếp sang Tả Van.","den":"The landing field by Lao Chai bridge, among the terraces. From here you can walk on to Ta Van.","n":11},{"id":"cat-cat","cat":"trek","lat":22.32853,"lon":103.83468,"vi":"Bản Cát Cát","en":"Cat Cat village","dvi":"Bản người Mông cách thị trấn khoảng 3 km, có thác nước và các guồng nước.","den":"A Hmong village about 3 km from town, with a waterfall and water wheels.","n":12},{"id":"y-linh-ho","cat":"trek","lat":22.31439,"lon":103.85726,"vi":"Ý Linh Hồ","en":"Y Linh Ho","dvi":"Bản nhỏ trên cung trek xuống thung lũng Mường Hoa, điểm dừng chân giữa đường.","den":"A small village on the trek down into Muong Hoa Valley, a usual rest stop.","n":13},{"id":"ta-van","cat":"trek","lat":22.30266,"lon":103.88858,"vi":"Bản Tả Van","en":"Ta Van village","dvi":"Bản người Giáy giữa thung lũng, nhiều homestay; điểm cuối quen thuộc của cung trek trong ngày.","den":"A Giay village in the valley with many homestays; the usual end of the one-day trek.","n":14},{"id":"giang-ta-chai","cat":"trek","lat":22.29791,"lon":103.90227,"vi":"Giàng Tà Chải","en":"Giang Ta Chai","dvi":"Bản người Dao Đỏ, đường trek đi qua rừng trúc và thác nước.","den":"A Red Dao village; the trail passes a bamboo forest and a waterfall.","n":15},{"id":"ban-ho","cat":"trek","lat":22.26369,"lon":103.96805,"approx":true,"vi":"Bản Hồ – suối nước nóng","en":"Ban Ho – hot spring","dvi":"Bản người Tày cuối thung lũng, có suối nước nóng tự nhiên gần bản.","den":"A Tay village at the end of the valley, with a natural hot spring nearby.","n":16},{"id":"seo-my-ty","cat":"trek","lat":22.25059,"lon":103.89161,"vi":"Hồ Séo Mý Tỷ","en":"Seo My Ty Lake","dvi":"Hồ trên núi cao phía trên Tả Van, đường lên dốc và quanh co.","den":"A high mountain lake above Ta Van, reached by a steep winding road.","n":17},{"id":"ta-phin","cat":"trek","lat":22.39529,"lon":103.84303,"vi":"Bản Tả Phìn","en":"Ta Phin village","dvi":"Bản người Dao Đỏ phía bắc thị trấn, nổi tiếng với nghề thêu và tắm lá thuốc.","den":"A Red Dao village north of town, known for embroidery and herbal baths.","n":18},{"id":"alpine-coaster","cat":"trek","lat":22.32256,"lon":103.86656,"vi":"Alpine Coaster – Bản Mông","en":"Alpine Coaster – Ban Mong","dvi":"Máng trượt trên sườn núi, ngay trên đường từ thị trấn lên điểm cất cánh dù lượn.","den":"A mountain coaster on the hillside, on the road from town to the paragliding take-off.","n":19},{"id":"silver-waterfall","cat":"nature","lat":22.36324,"lon":103.77683,"vi":"Thác Bạc","en":"Silver Waterfall","dvi":"Thác nước ngay cạnh quốc lộ 4D, cách thị trấn khoảng 12 km.","den":"A waterfall right beside road 4D, about 12 km from town.","n":20},{"id":"love-waterfall","cat":"nature","lat":22.34734,"lon":103.77243,"vi":"Thác Tình Yêu","en":"Love Waterfall","dvi":"Đi bộ khoảng 30 phút qua rừng trong Vườn quốc gia Hoàng Liên để tới thác.","den":"About a 30-minute forest walk inside Hoang Lien National Park.","n":21},{"id":"o-quy-ho","cat":"nature","lat":22.35297,"lon":103.76481,"vi":"Đèo Ô Quy Hồ – Cổng Trời","en":"O Quy Ho Pass – Heaven's Gate","dvi":"Một trong những đèo dài nhất Tây Bắc, điểm ngắm hoàng hôn và biển mây.","den":"One of the longest passes in the Northwest, a sunset and sea-of-clouds viewpoint.","n":22},{"id":"rong-may","cat":"nature","lat":22.3727,"lon":103.75729,"vi":"Cầu kính Rồng Mây","en":"Rong May Glass Bridge","dvi":"Khu du lịch cầu kính và trò chơi cảm giác mạnh bên kia đèo Ô Quy Hồ.","den":"A glass bridge and thrill park on the far side of O Quy Ho Pass.","n":23}],"routes":[{"id":"trek-valley","kind":"trek","vi":"Cung trek thung lũng Mường Hoa: Sa Pa – Cát Cát – Ý Linh Hồ – Lao Chải – Tả Van – Giàng Tà Chải – Bản Hồ","en":"Muong Hoa Valley trek: Sapa – Cat Cat – Y Linh Ho – Lao Chai – Ta Van – Giang Ta Chai – Ban Ho","km":26.1,"pts":[[22.33446,103.84077],[22.33399,103.84061],[22.33374,103.84096],[22.33262,103.8396],[22.33251,103.83909],[22.33288,103.83835],[22.33287,103.83744],[22.33264,103.83747],[22.3326,103.83692],[22.33206,103.83701],[22.33129,103.83669],[22.33114,103.83701],[22.33098,103.83672],[22.33066,103.83667],[22.33081,103.83629],[22.3306,103.83617],[22.33099,103.83555],[22.33115,103.83454],[22.331,103.83406],[22.3311,103.83307],[22.33142,103.83267],[22.33198,103.83239],[22.33199,103.83192],[22.33115,103.8314],[22.33145,103.83031],[22.33114,103.82954],[22.33068,103.82973],[22.33075,103.83001],[22.33029,103.83031],[22.33011,103.83012],[22.32981,103.83026],[22.32875,103.83179],[22.32841,103.8316],[22.32823,103.83176],[22.32839,103.83257],[22.32815,103.83338],[22.32711,103.83482],[22.32722,103.83507],[22.32763,103.83486],[22.32822,103.83508],[22.32858,103.